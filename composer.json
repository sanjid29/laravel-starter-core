{
    "name": "sanjid29/laravel-starter-core",
    "description": "Core infrastructure for Laravel starter kit — base controllers, traits, middleware, and CRUD scaffolding commands.",
    "type": "library",
    "keywords": [
        "laravel",
        "crud",
        "scaffolding",
        "starter-kit",
        "datatables",
        "spatie-permission",
        "admin"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Sanjid Habib",
            "email": "sanjidhabib@gmail.com",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/sanjid29/laravel-starter-core/issues",
        "source": "https://github.com/sanjid29/laravel-starter-core"
    },
    "require": {
        "php": "^8.4",
        "laravel/framework": "^12.0 || ^13.0",
        "spatie/laravel-permission": "^7.0 || ^8.0",
        "spatie/laravel-activitylog": "^4.0 || ^5.0",
        "spatie/laravel-medialibrary": "^11.0",
        "yajra/laravel-datatables-oracle": "^12.0 || ^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpunit/phpunit": "^11.5.50 || ^12.0 || ^13.0",
        "laravel/pint": "^1.18",
        "larastan/larastan": "^3.0",
        "barryvdh/laravel-dompdf": "^3.1.2",
        "phpoffice/phpspreadsheet": "^5.0"
    },
    "suggest": {
        "barryvdh/laravel-dompdf": "Required for PDF export in BaseReportController (^3.1.2)",
        "phpoffice/phpspreadsheet": "Required for Excel/CSV export in BaseReportController (^5.0)"
    },
    "autoload": {
        "psr-4": {
            "Sanjid29\\StarterCore\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Sanjid29\\StarterCore\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-text",
        "format": "pint",
        "lint": "pint --test",
        "analyse": "phpstan analyse"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Sanjid29\\StarterCore\\StarterKitServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
